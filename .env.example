# monkey-army — configuration reference
#
# This is the only place configuration lives. There is no config.json, no
# credentials.json, no key dialog, no profile. Every value below is read
# straight from the environment on each call; a missing or invalid required
# variable is a loud error naming the variable, not a fallback.
#
# IMPORTANT: the MCP server inherits the environment of the Claude Code
# process — it does not read this file. Export these in the shell you launch
# Claude Code from, or set them in ~/.zshenv, then restart Claude Code so the
# new process picks them up. Copy the lines you want; this file itself is
# never read by the plugin.

## Required — missing or invalid is a startup/dispatch error naming the variable

# OpenAI-compatible endpoint (your 9Router or equivalent). Must start with
# http:// or https://.
MONKEY_9ROUTER_BASE_URL=http://localhost:20128/v1

# Worker API key. Passed to the worker process only — never logged, never
# printed, never sent to the supervisor model. Must be non-empty.
MONKEY_9ROUTER_KEY=

# litellm model string, e.g. openai/combo/deepseek-main. Must contain a "/";
# a bare model name or a "litellm:" prefix is rejected. Run
# configure(action="discover_models") to list the combos your 9Router key
# can see.
MONKEY_WORKER_MODEL=

## Optional worker settings (code default shown; env is the only override)

# Comma-separated litellm model strings tried after MONKEY_WORKER_MODEL fails.
# MONKEY_FALLBACK_MODELS=

# USD per 1M input/output tokens. Unset means priced:false unless litellm
# already knows the price for this model.
# MONKEY_PRICE_INPUT_PER_MTOK=
# MONKEY_PRICE_OUTPUT_PER_MTOK=

# Extra litellm kwargs as a JSON object, e.g. {"temperature":0}.
# MONKEY_MODEL_KWARGS_JSON={}

## Optional limits (code default shown; env is the only override)

# MONKEY_MAX_BUDGET_USD=0.50
# MONKEY_MAX_TOKENS_TOTAL=400000
# MONKEY_TIMEOUT_S=900
# MONKEY_STALL_S=180
# MONKEY_COMMAND_TIMEOUT_S=120
# MONKEY_ASK_TIMEOUT_S=600
# MONKEY_RECURSION_LIMIT_MICRO=80
# MONKEY_RECURSION_LIMIT_TASK=400
# MONKEY_RUBRIC_MAX_ITERATIONS_TASK=4
# MONKEY_MAX_DIFF_LINES=300
# MONKEY_INTEGRATE_MODE=commit          # commit | stage
# MONKEY_VERIFY_TIMEOUT_S=300
# MONKEY_WAIT_TIMEOUT_S=120             # hard cap 170s, not configurable
# MONKEY_PREFLIGHT_TIMEOUT_S=60
# MONKEY_PROBE_TTL_S=600
# MONKEY_CONVENTIONS_MAX_CHARS=4000
# MONKEY_NOTES_MAX_CHARS=2000

# State directory (jobs, logs, patches, worktrees, notes). Tests and the e2e
# driver point this at a temp dir so they never touch your real state.
# MONKEY_ARMY_HOME=~/.monkey-army

## Set by the server for the worker subprocess only — never set these yourself

#   MONKEY_WORKER_API_KEY   the resolved key, passed to the worker alone
#   MONKEY_COMM_DIR         the worker's question/answer mailbox
#   MONKEY_ASK_TIMEOUT_S    resolved timeout, injected into the worker's env
