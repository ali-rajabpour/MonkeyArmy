# monkey-army — environment reference
#
# NOTHING here is required. The plugin is configured through the `configure`
# tool (`/monkey-setup`), which writes ~/.monkey-army/config.json and stores
# the API key in ~/.monkey-army/credentials.json (mode 0600). These variables
# exist for machines where you would rather keep the endpoint and key in the
# shell — CI, a shared box, or a first run before any profile exists.
#
# This file is a reference. Copy the lines you want into your shell profile
# (~/.zshenv, ~/.bashrc); the plugin never reads a .env file.
#
# IMPORTANT: the MCP server inherits the environment of the Claude Code
# process. Exporting a variable in a shell only reaches the workers if Claude
# Code was started from that shell afterwards.

# Base URL of your 9Router (or any OpenAI-compatible endpoint).
# Used only when the active profile has no api_base of its own; a profile's
# own api_base always wins.
MONKEY_9ROUTER_BASE_URL=http://localhost:20128/v1

# Worker API key. The profile names the variable it expects
# (`api_key_env_var`, default MONKEY_9ROUTER_KEY); resolution order is
# credentials.json first, then this environment variable.
# Prefer `configure(action="store_key", profile=...)`, which asks for the key
# in a dialog so it never passes through the model's context.
MONKEY_9ROUTER_KEY=

# State directory. Defaults to ~/.monkey-army; tests and the e2e driver set
# it to a temp dir so they never touch your real configuration.
# MONKEY_ARMY_HOME=/path/to/state

# Set by the server for the worker process only — never set these yourself:
#   MONKEY_WORKER_API_KEY   the resolved key, passed to the worker alone
#   MONKEY_COMM_DIR         the worker's question/answer mailbox
#   MONKEY_ASK_TIMEOUT_S    how long a worker waits for an answer
